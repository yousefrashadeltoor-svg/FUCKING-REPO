{
  "name": "don-muse",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:android": "tsc --noEmit && vite build --mode android --outDir android/app/src/main/assets/www --emptyOutDir",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:android": "node scripts/check-android.mjs",
    "bundle": "npm run build:android && node scripts/check-android.mjs --bundle"
  },
  "dependencies": {
    "@types/youtube": "^0.3.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.577.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.13.1",
    "simple-icons": "^16.36.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
